<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- code created by  / Skype :  / Mail = @gmail.com -->
    <data>

        <variable
            name="model"
            type="com.mob.xtravuwatchdog.utils.Dialog1" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="20dp"
        android:background="@drawable/bg_white_corner_15"
        android:backgroundTint="@color/black"
        android:gravity="center"
        android:paddingStart="@dimen/_30sdp"
        android:paddingEnd="@dimen/_30sdp"
        android:paddingTop="@dimen/_20sdp"
        android:paddingBottom="@dimen/_20sdp"
        android:orientation="vertical">


        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/inter_bold"
            android:gravity="center"
            android:text="@{model.title}"
            android:textColor="@color/white"
            android:textSize="18sp"
            tools:text="@string/app_name" />


        <ImageView
            android:id="@+id/logo_icon"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginTop="10dp"
            android:padding="10dp"
            android:tint="@color/white"
            android:src="@drawable/ic_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/inter_regular"
            android:gravity="center"
            android:text="@{model.message}"
            android:alpha="0.5"
            android:textColor="@color/white"
            android:textSize="16sp"
            tools:text="@string/block_confirmation" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="25dp"
            android:background="@drawable/bg_white_bottom_15"
            android:backgroundTint="@color/transparent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_cancel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@{model.negativeText}"
                tools:text="Cancel"
                android:focusable="true"
                android:clickable="true"
                android:background="@drawable/blue_rounded_button_drawable"
                android:layout_marginEnd="@dimen/_5sdp"
                android:textColor="@color/white" />

            <View
                android:id="@+id/line"
                android:layout_width="1dp"
                android:layout_marginVertical="@dimen/_8sdp"
                android:layout_marginHorizontal="@dimen/_2sdp"
                android:layout_height="match_parent"
                android:background="@color/gray" />

            <TextView
                android:id="@+id/tv_positive"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@{model.positiveText}"
                android:focusable="true"
                android:clickable="true"
                android:background="@drawable/blue_rounded_button_drawable"
                android:layout_marginEnd="@dimen/_5sdp"
                android:textColor="@color/white"
                tools:text="ok" />

        </LinearLayout>


    </LinearLayout>

</layout>