<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:id="@+id/llLoginWithPhn"
    android:orientation="vertical"
    android:gravity="center"
    android:layout_gravity="center"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:background="@drawable/rounded_rectangle"
        android:backgroundTint="@color/login_dialog_bg_color"
        android:layout_margin="25dp"
        android:orientation="vertical"
        android:padding="10dp"
        android:layout_gravity="center"
        android:layout_height="wrap_content">


        <ImageView
            android:layout_marginTop="15dp"
            android:layout_height="@dimen/_40sdp"
            android:layout_width="@dimen/_40sdp"
            android:layout_gravity="center"
            android:src="@drawable/ic_logo"></ImageView>

        <TextView
            android:id="@+id/tv_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:layout_margin="@dimen/_10sdp"
            android:textSize="14dp"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:textColor="@color/gray"
            />



        <TextView
            android:layout_marginTop="20dp"
            android:layout_gravity="center"
            android:id="@+id/txtOk"
            android:layout_width="@dimen/_50sdp"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/gray_rounded_button_drawable"
            android:gravity="center"
            android:padding="10dp"
            android:text="OK"
            android:textColor="@color/white"
            android:textAllCaps="true"></TextView>



    </LinearLayout>


</LinearLayout>