<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <import type="android.view.View"/>
        <variable
            name="sessionManager"
            type="com.mob.xtravuwatchdog.utils.SessionManager" />
    </data>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black">
        <FrameLayout
            android:id="@+id/rootPlayerLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:nextFocusDown="@id/ic_settings"
            android:nextFocusUp="@id/rootPlayerLayout"
            android:focusable="true"
            android:visibility="visible">
            <ImageView
                android:id="@+id/ic_settings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="25dp"
                android:elevation="20dp"
                android:focusable="true"
                android:clickable="true"
                android:layout_gravity="end"
                android:nextFocusDown="@id/licenceActivateIcon"
                android:nextFocusUp="@id/rootPlayerLayout"
                android:background="@drawable/item_selector"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_setting"
                />
            <!-- VideoView or ExoPlayer's PlayerView -->
            <VideoView
                android:id="@+id/video_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:adjustViewBounds="true"
                android:visibility="gone"
                android:scaleType="fitXY"/>

            <!--
               <TextureView
                android:id="@+id/video_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:adjustViewBounds="true"
                android:visibility="gone"
                android:scaleType="fitXY"/>
          -->
             <com.google.android.exoplayer2.ui.PlayerView
                android:id="@+id/playerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:use_controller="false"
                android:visibility="visible"/>


            <!-- ImageView for images -->
            <ImageView
                android:id="@+id/image_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone" />
            <ImageView
                android:id="@+id/thumb_image_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone" />
            <WebView
                android:id="@+id/webview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"/>
            <android.media.tv.TvView
                android:id="@+id/tv_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                android:layout_margin="0dp"/>
            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_centerInParent="true"
                android:visibility="gone" />
            <ProgressBar
                android:id="@+id/downloadProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:max="100"/>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_gravity="bottom|end">
            <ImageView
                android:id="@+id/licenceActivateIcon"
                android:layout_width="@dimen/_110sdp"
                android:layout_height="@dimen/_90sdp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="@dimen/_20sdp"
                android:nextFocusDown="@id/rootPlayerLayout"
                android:nextFocusUp="@id/ic_settings"
                android:padding="@dimen/_5sdp"
                android:src="@drawable/logo_transparent"/>
        </LinearLayout>
        </FrameLayout>
        <RelativeLayout
            android:id="@+id/rootLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:layout_marginTop="@dimen/_100sdp"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">


        </RelativeLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
