<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/high_light_color"/> <!-- Background color when focused -->
            <corners android:radius="0dp"/>
            <stroke android:width="0dp" android:color="@color/setting_border_color"/> <!-- Optional border on focus -->
        </shape>
    </item>

    <!-- Default state -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/transparent"/> <!-- Default background color -->
            <corners android:radius="0dp"/>
        </shape>
    </item>
</selector>
