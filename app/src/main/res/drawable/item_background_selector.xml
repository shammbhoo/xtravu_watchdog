<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state (when the item is clicked) -->
    <item android:state_pressed="true">
        <color android:color="@color/setting_border_color" />
    </item>

    <!-- Focused state (when the item is hovered or focused) -->
    <item android:state_focused="true">
        <color android:color="@color/white_08" />
    </item>

    <!-- Default state -->
    <item>
        <color android:color="@color/transparent" />
    </item>
</selector>
